{
  "name": "molr",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "npm run check:contracts && npm run docs:check && npm run check:platforms && npm run check:release && npm run check:licenses",
    "check:contracts": "node scripts/check-contracts.mjs",
    "dev:desktop": "npm run dev --workspace @molr/desktop --",
    "build:desktop": "npm run build --workspace @molr/desktop",
    "test:desktop": "npm run test --workspace @molr/desktop",
    "test:desktop:electron": "npm run test:electron --workspace @molr/desktop",
    "package:desktop": "npm run package --workspace @molr/desktop --",
    "dev": "npm run dev --workspace @molr/webui --",
    "dev:design": "npm run dev --workspace @molr/ui-design --",
    "dev:website": "npm run dev --workspace @molr/website --",
    "brand:generate": "npm run brand:generate --workspace @molr/ui",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:ui": "npm run test --workspace @molr/ui-design --",
    "test:website": "npm run test --workspace @molr/website --",
    "build": "npm run build --workspaces --if-present",
    "build:website": "npm run build --workspace @molr/website --",
    "preview": "npm run preview --workspace @molr/ui-design --",
    "preview:website": "npm run preview --workspace @molr/website --",
    "dev:webui": "npm run dev --workspace @molr/webui --",
    "build:webui": "npm run build --workspace @molr/webui --",
    "preview:webui": "npm run preview --workspace @molr/webui --",
    "test:webui": "npm run test --workspace @molr/webui --",
    "release:promote": "node scripts/promote-release.mjs",
    "build:release": "node scripts/build-release.mjs",
    "test:quick-start": "node scripts/test-quick-start.mjs",
    "check:licenses": "node scripts/check-license-review.mjs",
    "notices:update": "python3 scripts/update-third-party-notices.py",
    "notices:check": "python3 scripts/update-third-party-notices.py --check",
    "check:release": "python3 scripts/release_safety.py check",
    "build:source": "python3 scripts/release_safety.py source",
    "test:release": "python3 scripts/test_release_safety.py",
    "release:platforms": "node scripts/generate-platforms.mjs",
    "check:platforms": "node scripts/generate-platforms.mjs --check",
    "release:manifest": "node scripts/release-manifest.mjs",
    "release:catalog": "node scripts/release-catalog.mjs",
    "test:release-flow": "node --test scripts/test-release-flow.mjs scripts/test-release-publish.mjs scripts/test-release-mirror.mjs scripts/test-website-deployment.mjs scripts/test-desktop-release.mjs scripts/test-pipeline.mjs",
    "test:release-install": "node scripts/test-release-install.mjs",
    "build:website:release": "node scripts/build-release-website.mjs",
    "docs:generate": "node scripts/generate-molr-docs.mjs",
    "docs:check": "node scripts/generate-molr-docs.mjs --check",
    "test:docs": "node --test scripts/test-molr-docs.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "js-yaml": "4.3.2"
  }
}
