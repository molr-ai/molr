# Molr's trusted launcher selects this profile for Bubblewrap. Nested Chromium
# sandboxes need user namespaces and capabilities inside those namespaces.
# Molr still applies its own mount, seccomp, network and cgroup boundaries.
# This is an explicit application exemption, not a global AppArmor/sysctl change.
abi <abi/4.0>,
include <tunables/global>

profile molr-bwrap flags=(unconfined) {
  userns,
}
