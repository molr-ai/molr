{
  "logging": { "max_file_bytes": 268435456, "backup_files": 1 },
  "diagnostics": { "model_responses": false },
  "debug": { "enabled": false, "max_runs": 1000, "max_payload_bytes": 4194304 },
  "pricing": { "rules_file": "", "rules_url": "", "exchange_rates_file": "" },
  "data_dir": "/var/lib/molr",
  "network": { "allowed_private_ips": ["127.0.0.1"] },
  "http": {
    "listen": "0.0.0.0:8080",
    "public_url": "https://molr.example.com",
    "tls_mode": "direct",
    "cert_file": "/etc/molr/tls/fullchain.pem",
    "key_file": "/etc/molr/tls/key.pem"
  }
}
