{
  "data_dir": "/data",
  "http": {
    "listen": "0.0.0.0:8787",
    "public_url": "http://127.0.0.1:8787",
    "tls_mode": "lan",
    "allowed_origins": ["http://127.0.0.1:8787"]
  },
  "sandbox": {
    "enabled": true,
    "allow_full_access": true,
    "host_tools": true,
    "restrict_directories": false,
    "network_presets": ["internet", "lan", "host"],
    "authorization_ceilings": {"TempBytes": 0, "MaxFileBytes": 0, "NetworkBytes": 0, "NetworkConnections": 0},
    "gpu": {"enabled": true, "all_devices": true}
  }
}
